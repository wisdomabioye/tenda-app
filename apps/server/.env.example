# ============================================================================
# Tenda server environment — copy to .env and fill in.
#
# REQUIRED vars fail boot when missing (see REQUIRED_ENV_VARS in
# src/config.ts). Everything else is optional: unset = the feature is
# disabled or a documented default applies. Stage/step references map to
# the user-action task list (steps 1–13).
# ============================================================================

# ---------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/tenda
# ≥32 random chars in production
JWT_SECRET=your-jwt-secret-here
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
SOLANA_RPC_URL=https://api.devnet.solana.com
# Platform treasury wallet (base58) — receives fees on approve_completion
SOLANA_TREASURY_ADDRESS=4Nd1mYvK4Pm1x2HCmzCx5GQDV9KbpMK128bxgL5dVDU1
# Deployed tenda_escrow program id (base58)
SOLANA_PROGRAM_ID=7H6AAoghUCPAVA1WTEwpSmkiRfPHWrgFidZQPzbXzkes
# Public base URL of THIS deployment, no trailing slash — asserted against
# the `URI:` line of signed auth messages (cross-deployment replay defense)
API_BASE_URL=https://api.tenda.example

# ---------------------------------------------------------------------------
# Core (optional — defaults in src/config.ts)
# ---------------------------------------------------------------------------
#NODE_ENV=development
#PORT=3000
# JWT lifetime, e.g. '7d', '24h' (default 7d)
#JWT_EXPIRES_IN=7d
# Seed fallback ONLY — runtime fee is read from the platform_config table
#PLATFORM_FEE_BPS=250
# 'devnet' | 'mainnet-beta' (default devnet). Drives chain registry + seeds.
#SOLANA_NETWORK=devnet
# Devnet faucet USDC / Circle mint on mainnet. Unset = USDC_SOL asset not
# seeded and gig creation with USDC_SOL rejects.
#SOLANA_USDC_MINT=

# ---------------------------------------------------------------------------
# CORS (production: set both; unset = any origin, dev only)
# ---------------------------------------------------------------------------
# Comma-separated origins for the public API
#CORS_ORIGIN=https://app.tenda.example
# Admin panel origins — /v1/admin/* rejects browser requests from elsewhere
#ADMIN_ORIGIN=https://admin.tenda.example

# ---------------------------------------------------------------------------
# Mobile deep links
# ---------------------------------------------------------------------------
# SHA-256 cert fingerprint for Android App Links (assetlinks.json)
#ANDROID_SHA256_FINGERPRINT=AA:BB:CC:...

# ---------------------------------------------------------------------------
# Step 1 — Redis / BullMQ (#33). RESERVED: consumed by the worker wiring
# that lands once Redis exists; the queue plugin 501s until then.
# ---------------------------------------------------------------------------
#REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Step 2 — Solana event listener (#43)
# ---------------------------------------------------------------------------
# Shared secret Helius sends in the webhook Authorization header.
# Unset = webhook 503s; LISTENER_PROVIDER=polling carries verification.
#HELIUS_WEBHOOK_SECRET=
# 'helius' (default) | 'polling' — polling needs no external account
#LISTENER_PROVIDER=helius

# ---------------------------------------------------------------------------
# Step 3 — Phone OTP via Termii (#32)
# Unset = OTP codes log to console (dev mode); no real SMS.
# ---------------------------------------------------------------------------
#TERMII_API_KEY=
#TERMII_SENDER_ID=

# ---------------------------------------------------------------------------
# Step 4 — Solana gas seed (#40)
# base58 SECRET key of the funded hot wallet. Unset = no seed dispatched
# (verification still succeeds; grant retried on next wallet link).
# ---------------------------------------------------------------------------
#SOLANA_GAS_SEED_WALLET_KEY=

# ---------------------------------------------------------------------------
# Step 5 — LLM moderation via OpenRouter (#56)
# Unset = keyword-only moderation (suspicious → warn).
# ---------------------------------------------------------------------------
#OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Step 6 — Native push (#53). Unset = Expo push fallback.
# ---------------------------------------------------------------------------
# base64 of the Firebase service-account JSON (FCM HTTP v1)
#FCM_SERVICE_ACCOUNT_B64=
# APNs token auth (.p8 key, base64) — APNS_TOPIC is the iOS bundle id
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_PRIVATE_KEY_B64=
#APNS_TOPIC=com.tenda.app

# ---------------------------------------------------------------------------
# Step 9 — Fiat rails (#61). Feature gate defaults ON (p2p_internal always
# works); licensed providers register only when their keys exist.
# ---------------------------------------------------------------------------
#FIAT_RAILS_ENABLED=true
#YELLOWCARD_API_KEY=
#YELLOWCARD_API_SECRET=
#YELLOWCARD_WEBHOOK_SECRET=
#ONRAMPMONEY_API_KEY=
#ONRAMPMONEY_API_SECRET=
#ONRAMPMONEY_WEBHOOK_SECRET=
# NIP name-enquiry (bank-account verification). Reserved: vendor call
# lands with #61; accounts save unverified until then.
#NIP_API_KEY=

# ---------------------------------------------------------------------------
# Step 10 — BASE / eip155:8453 (#47). All unset = chain not registered.
# ---------------------------------------------------------------------------
#BASE_RPC_URL=
# Deployed TendaEscrow.sol address (after audit)
#BASE_ESCROW_ADDR=
# Circle USDC on BASE: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#BASE_USDC_ADDR=
# Safe 3-of-5 — admin + treasury on BASE
#MULTISIG_BASE_ADDR=
# Coinbase paymaster JSON-RPC endpoint (sponsors first-3 txs)
#COINBASE_PAYMASTER_URL=
# Alchemy webhook signing key (x-alchemy-signature HMAC)
#ALCHEMY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Step 11 — CELO / eip155:42220 (#49). All unset = chain not registered.
# Token addresses are code constants (chains/celo/config.ts) — not env.
# ---------------------------------------------------------------------------
#CELO_RPC_URL=https://forno.celo.org
#CELO_ESCROW_ADDR=
#MULTISIG_CELO_ADDR=

# ---------------------------------------------------------------------------
# Step 12 — admin dashboard login (#86/#89). Key unset: dev logs OTP codes;
# production answers 503 on send-email-otp until Resend is configured.
# ---------------------------------------------------------------------------
#RESEND_API_KEY=
#EMAIL_FROM=Tenda Admin <admin@tenda.app>
# Admin-dashboard JWT lifetime (own knob; mobile JWT_EXPIRES_IN stays 7d)
#ADMIN_JWT_EXPIRES_IN=12h
