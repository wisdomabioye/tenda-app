{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    // baseUrl is required for `paths` to resolve relative to apps/server/ (not
    // this test/ dir). Without it, "@server/*" -> "./src/*" resolved to
    // test/src/* and every @server import failed under `tsc -p test/tsconfig`.
    "paths": {
      "@server/*": ["./src/*"]
    }
  },
  "include": ["../src/**/*.ts", "**/*.ts"]
}
