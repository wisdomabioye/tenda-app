# ============================================================================
# Tenda mobile environment — copy to .env.local and fill in.
# Expo loads .env.local automatically; EXPO_PUBLIC_* vars are embedded in
# the JS bundle (never put secrets behind that prefix).
# ============================================================================

# REQUIRED — the API the app talks to (host only; routes carry /v1).
# The WebSocket URL is derived from this (http→ws + /v1/ws).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Build profile: 'development' (default) | 'staging' | 'production'.
# Set via EAS build profiles in CI; drives Solana cluster + API selection.
#APP_ENV=development

# Sentry source-map upload token — build-time only, never bundled.
# DO NOT COMMIT a real value.
#SENTRY_AUTH_TOKEN=

# Path to google-services.json for FCM (defaults to ./google-services.json)
#GOOGLE_SERVICES_JSON=./google-services.json

# ---------------------------------------------------------------------------
# Google Sign-In (Stage 9B). All three are USER-ACTION credentials minted
# when the Google OAuth client is created. Unset = Google sign-in fails
# cleanly (configureGoogleSignIn gets undefined) and the iOS URL-scheme
# plugin is skipped, so `expo config` / the dev loop still work without them.
# The web client ID here MUST be listed in the server's GOOGLE_OAUTH_CLIENT_IDS.
# ---------------------------------------------------------------------------
# Web OAuth client ID — used for id_token sign-in on both platforms.
#EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# iOS OAuth client ID.
#EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=yyyy.apps.googleusercontent.com
# Reversed iOS client ID (com.googleusercontent.apps.yyyy) — build-time only;
# when set, adds the google-signin Expo plugin with this iOS URL scheme.
#GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.yyyy
